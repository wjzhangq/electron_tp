{
  "name": "my-app",
  "productName": "My App",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop shell: Electron + TypeScript + chttp virtual HTTP server",
  "keywords": [],
  "license": "MIT",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "build:plugins": "tsx scripts/build-plugins.ts",
    "start": "npm run build:plugins && electron-forge start",
    "package": "electron-forge package --platform=win32 --arch=x64",
    "make": "electron-forge make --platform=win32 --arch=x64",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run package && npm run build:plugins && playwright test",
    "check:tamper": "tsx scripts/tamper-check.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-base": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "44.9.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {}
}
